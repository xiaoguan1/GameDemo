-- 主节点配置

thread = 8 --启用多少个工作线
cpath = "./skynet/cservice/?.so" --用C编写的服务模块的位置
bootstrap = "snlua bootstrap" --启动的第一个服务
--bootstrap配置
start = "main" --主服务
harbor = 0 --不使用主从节点模式

--lua配置
lualoader = "./skynet/lualib/loader.lua"

-- lua服务
luaservice = "./tool/service/startup/?.lua;" ..			-- 起服相关
			"./tool/service/basic/?/?.lua;" ..			-- 基础设施功能（定时器、集群、数据库等等）
			"./game/service/?/?.lua;" ..				-- 游戏玩法逻辑服务
			"./skynet/service/?.lua;" ..				-- skynet内置服务
			"./skynet/examples/?.lua;"

lua_path = "./lualib/?.lua;" ..
			"./skynet/lualib/?.lua;" ..
			"./skynet/lualib/?/init.lua;" ..
			"./game/global/?.lua;" ..
			"./game/global/findpath/?.lua;"
lua_cpath = "./luaclib/?.so;" .. "./skynet/luaclib/?.so;" .. "./tool/cplugins-so/?.so"

--后台模式（必要时开启）
-- daemon = "./log/skynet.pid"
-- logger = "./log/userlog"

profile = true		-- 默认位true的
profile_cmd = true	-- 细化指令检测

apreload = "tool/luaplugins/apreload.lua"  -- 目的：main完成必要的操作后 才对后续服务开放加载节点数据
preload = "tool/luaplugins/preload.lua"
