-- 普通跨服节点配置

thread = 8 --启用多少个工作线
cpath = "./skynet/cservice/?.so" --用C编写的服务模块的位置
bootstrap = "snlua bootstrap" --启动的第一个服务
--bootstrap配置
start = "cross" --主服务
harbor = 0 --不使用主从节点模式

--lua配置
lualoader = "./skynet/lualib/loader.lua"

-- lua服务
luaservice = "./tool/service/startup/?.lua;" ..			-- 起服相关
			"./tool/service/basic/?/?.lua;" ..			-- 基础设施功能（定时器、集群、数据库等等）
			"./game/service/?/?.lua;" ..				-- 游戏玩法逻辑服务
			"./skynet/service/?.lua;" ..				-- skynet内置服务
			"./skynet/examples/?.lua;"

lua_path = "./game/global/?.lua;" ..
			"./lualib/?.lua;" ..
			"./skynet/lualib/?.lua;" ..
			"./skynet/lualib/?/init.lua;"

-- lua_path = "./lualib/?.lua;" ..
-- 			"./skynet/lualib/?.lua;" ..
-- 			"./skynet/lualib/?/init.lua;" ..
-- 			"./game/global/?.lua;"


lua_cpath = "./luaclib/?.so;" ..
			"./skynet/luaclib/?.so;" ..
			"./tool/cplugins-so/?.so"

--后台模式（必要时开启）
